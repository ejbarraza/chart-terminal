{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "height": 900,
        "minHeight": 640,
        "minWidth": 1000,
        "title": "Chart Terminal",
        "width": 1440
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5000",
    "frontendDist": "../static"
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Chart Terminal \u2014 a free, self-hosted TradingView-style charting app. Candlesticks, indicators, drawing tools and watchlists, powered by Yahoo Finance and Twelve Data.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "Free TradingView-style charting",
    "targets": "all"
  },
  "identifier": "com.ejbarraza.chart-terminal",
  "productName": "Chart Terminal",
  "version": "0.1.8"
}